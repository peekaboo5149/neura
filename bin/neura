#!/usr/bin/env node

/**
 * Neura CLI Entry Point
 *
 * This wrapper ensures module aliases are registered before
 * importing the main application code.
 */

// Mark as executable mode for production detection
// This must be set before importing main.ts
process.env.NEURA_EXECUTABLE = 'true';

// Register module aliases first (before any @ imports)
// eslint-disable-next-line @typescript-eslint/no-require-imports
require('module-alias/register');

// Import reflect-metadata for tsyringe DI
// eslint-disable-next-line @typescript-eslint/no-require-imports
require('reflect-metadata');

// Now import and run the main application
// eslint-disable-next-line @typescript-eslint/no-require-imports
require('../dist/src/main.js');
