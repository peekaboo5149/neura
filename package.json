{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "neura",
  "version": "1.0.0",
  "description": "An intelligent personal assistant framework with agent management, skill orchestration, and extensible AI capabilities - inspired by modern AI assistant architectures",
  "main": "dist/src/main.js",
  "bin": {
    "neura": "./bin/neura"
  },
  "preferGlobal": true,
  "_moduleAliases": {
    "@logging": "dist/src/logging",
    "@api": "dist/src/api",
    "@config": "dist/src/config",
    "@bootstrap": "dist/src/bootstrap",
    "@cli": "dist/src/cli",
    "@daemon": "dist/src/daemon",
    "@types": "dist/src/types"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "ts-node-dev --transpile-only --respawn --rs --clear -r reflect-metadata -r tsconfig-paths/register src/main.ts",
    "dev:typecheck": "ts-node-dev --respawn --rs --clear -r reflect-metadata -r tsconfig-paths/register src/main.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathPattern=test/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "assistant",
    "agent",
    "framework",
    "automation",
    "personal-assistant"
  ],
  "author": "Tanmay Kumar <ktanmay5149@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/peekaboo5149/neura.git"
  },
  "bugs": {
    "url": "https://github.com/peekaboo5149/neura/issues"
  },
  "homepage": "https://github.com/peekaboo5149/neura#readme",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "langchain": "^1.2.28",
    "module-alias": "^2.3.4",
    "openai": "^6.25.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.6"
  }
}
